<?xml version="1.0" encoding="UTF-8"?>
<configuration>

	<property name="LOG_CHARSET" value="${file.encoding:-UTF-8}"/>

	<property name="LOG_DATEFORMAT_PATTERN" value="yyyy-MM-dd HH:mm:ss.SSS"/>

	<property name="CONSOLE_LOG_PATTERN" value="%m%n"/>

	<property name="CONSOLE_LOG_THRESHOLD" value="INFO"/>

	<property name="FILE_LOG_PATTERN" value="%d{${LOG_DATEFORMAT_PATTERN}} %-5p [%-6t] %-42.42logger{41} : %m%n"/>

	<property name="LOG_FILE" value="${DOWNLOADER_HOME:-.}/logs/downloader"/>

	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>${CONSOLE_LOG_THRESHOLD}</level>
		</filter>
		<encoder>
			<charset>${LOG_CHARSET}</charset>
			<pattern>${CONSOLE_LOG_PATTERN}</pattern>
		</encoder>
	</appender>

	<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<encoder>
			<charset>${LOG_CHARSET}</charset>
			<pattern>${FILE_LOG_PATTERN}</pattern>
		</encoder>
		<file>${LOG_FILE}.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.log</fileNamePattern>
			<maxHistory>7</maxHistory>
		</rollingPolicy>
	</appender>

	<root level="INFO">
		<appender-ref ref="FILE"/>
	</root>

	<logger name="jkml.downloader" level="DEBUG"/>

	<logger name="jkml.downloader.Downloader">
		<appender-ref ref="CONSOLE"/>
	</logger>

	<logger name="org.apache.hc.client5.http.headers" level="OFF"/>

	<logger name="org.apache.hc.client5.http.wire" level="OFF"/>

</configuration>
